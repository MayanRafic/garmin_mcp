# syntax=docker/dockerfile:1
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 GARMINTOKENS=/data/garmin TZ=Asia/Jerusalem
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts/install_tunnel.py ./scripts/install_tunnel.py
# Railway's Docker builder does not support secret mounts.
RUN uv sync --locked --no-dev && .venv/bin/python scripts/install_tunnel.py
ENV PATH="/app/.venv/bin:${PATH}"
ENTRYPOINT ["garmin-mcp-cloud"]
